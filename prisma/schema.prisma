// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TAWZE3A_ADMIN
}

enum ServiceType {
  MEDICAL
  SUNDAY_SCHOOL
  YOUTH
  CHOIR
  VISITATION
  CHARITY
  OTHER
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(ADMIN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  inviteTokens InviteToken[]
}

model InviteToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  role      Role     @default(ADMIN)
  expiresAt DateTime
  createdBy String
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([email])
}

model Priest {
  id                 String    @id @default(cuid())
  name               String
  cloudinaryImageUrl String?
  ordinationDate     DateTime
  ordinationDateText String?   @db.VarChar(32)
  confessionSchedule String    @db.Text
  bio                String?   @db.Text
  qommosiyaDegree    String?
  deathDate          DateTime?
  deathDateText      String?   @db.VarChar(32)
  contactNumbers     String?   @db.Text
  order              Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sermons            Sermon[]
}

model Sermon {
  id        String   @id @default(cuid())
  title     String
  mediaUrl  String
  date      DateTime
  priestId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  priest    Priest   @relation(fields: [priestId], references: [id], onDelete: Cascade)

  @@index([priestId])
}

model Service {
  id          String      @id @default(cuid())
  title       String
  description String      @db.Text
  schedule    String
  type        ServiceType
  slug              String?   @unique
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parentId          String?
  parent            Service?  @relation("ServiceHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children          Service[] @relation("ServiceHierarchy")
  imageDisplayMode  String    @default("NORMAL")

  @@index([parentId])
}

model NewsEvent {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  imageUrl    String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DynamicContent {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  title      String
  content    String   @db.LongText
  imageUrl   String?
  updatedAt  DateTime @updatedAt
}

model Relic {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model ChurchActivity {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  imageUrl    String?
  link        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

enum LiturgySection {
  SCHEDULE
  LIVE
  RITES
  CALENDAR
}

model LiturgyEntry {
  id          String         @id @default(cuid())
  section     LiturgySection
  title       String
  description String         @db.Text
  detail      String?
  imageUrl    String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([section])
}

model MediaCollection {
  id                String      @id @default(cuid())
  title             String
  description       String      @db.Text
  slug              String?     @unique
  imageUrl          String?     @db.Text
  imageDisplayMode  String      @default("NORMAL")
  order             Int         @default(0)
  createdAt         DateTime    @default(now())
  items             MediaItem[]
}

model MediaItem {
  id           String          @id @default(cuid())
  collectionId String
  title        String          @default("")
  fileUrl      String?         @db.Text
  fileName     String?
  fileType     String          @default("link")
  thumbnail         String?         @db.Text
  imageDisplayMode  String          @default("NORMAL")
  link              String?         @db.Text
  linkLabel         String?
  order        Int             @default(0)
  createdAt     DateTime        @default(now())
  collection   MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
}

model PrayerRequest {
  id        String   @id @default(cuid())
  name      String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Servant {
  id          String               @id @default(cuid())
  name        String
  phone       String?              @unique
  nationalId  String?
  status      String?
  newUser     Boolean?             @default(false)
  assignments ServantAssignment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Tawze3a {
  id          String   @id @default(cuid())
  title       String
  isPublished Boolean  @default(false)
  khedmat     Khedma[]
  createdAt   DateTime @default(now())
}

model Khedma {
  id         String           @id @default(cuid())
  tawze3aId  String
  tawze3a    Tawze3a          @relation(fields: [tawze3aId], references: [id], onDelete: Cascade)
  name       String
  order      Int              @default(0)
  categories KhedmaCategory[]

  @@index([tawze3aId])
}

model KhedmaCategory {
  id          String               @id @default(cuid())
  khedmaId    String
  khedma      Khedma               @relation(fields: [khedmaId], references: [id], onDelete: Cascade)
  label       String
  roleType    String
  order       Int                  @default(0)
  assignments ServantAssignment[]

  @@index([khedmaId])
}

model ServantAssignment {
  id         String         @id @default(cuid())
  categoryId String
  category   KhedmaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  servantId  String
  servant    Servant        @relation(fields: [servantId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([servantId])
}
