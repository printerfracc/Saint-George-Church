# TiDB Serverless (Prisma)
DATABASE_URL=

# NextAuth
# Local dev uses port 3001 (`npm run dev`). Keep this in sync with the running app.
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

# Public site URL used in invite / WhatsApp links (optional)
NEXT_PUBLIC_APP_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PUBLIC_DOMAIN=

# Gmail SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# YouTube live status (optional)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=
